<Window x:Class="Interpolation_WPF.AddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Interpolation_WPF"
        mc:Ignorable="d"
        Title="Add Point" Height="400" Width="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="5*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Margin="5"
                       Text="X:"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="15"
                       />
            <TextBox Grid.Column="1"
                     Margin="5"
                     FontSize="15"
                     VerticalContentAlignment="Center"
                     Text="{Binding X, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>
        
        <DataGrid Grid.Row="1" Margin="5"
                  ItemsSource="{Binding Derivatives}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  FontSize="15">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header=""
                                    Binding="{Binding Name}" 
                                    IsReadOnly="True" Width="*"
                                    />

                <DataGridTextColumn Header="Value" Width="*"
                            Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Margin="5"
                    Content="Add"
                    FontSize="15" Click="Button_Add_Derivative"/>

            <Button Grid.Column="1" Margin="5"
                    Content="Delete"
                    FontSize="15" Click="Button_Delete"/>

            <Button Grid.Column="2" Margin="5"
                    Content="Save"
                    FontSize="15" Click="Button_Save"/>
        </Grid>

        

    </Grid>
</Window>
