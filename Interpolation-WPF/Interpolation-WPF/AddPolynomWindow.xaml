<Window x:Class="Interpolation_WPF.AddPolynomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Interpolation_WPF"
        mc:Ignorable="d"
        Title="AddPolynomWindow" Height="400" Width="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>


        <DataGrid Grid.Row="0" Margin="5"
              ItemsSource="{Binding Coefficients}"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              FontSize="15">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Term"
                                    Binding="{Binding Value, UpdateSourceTrigger=LostFocus}" 
                                    Width="*"/>
                                    

                <DataGridTextColumn Header="Variable" Width="*"
                                    Binding="{Binding Name}"
                                    IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Margin="5"
                Content="Add"
                FontSize="15" Click="Button_Add_Coefficient"/>

            <Button Grid.Column="1" Margin="5"
                Content="Delete"
                FontSize="15" Click="Button_Remove_Coefficient"/>

            <Button Grid.Column="2" Margin="5"
                Content="Save"
                FontSize="15" Click="Button_Save_Coefficient"/>
        </Grid>



    </Grid>
</Window>
